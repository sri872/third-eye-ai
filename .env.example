# Third Eye AI — optional environment overrides
# No API key or secret is required. Copy to .env only if you need an override.

# Point the Dispatch tab at a different stored dispatch summary JSON file.
# Default: data/outputs/dispatch_summary.json
# THIRD_EYE_DISPATCH_SUMMARY=/absolute/path/to/dispatch_summary.json

# TorchVision/Hugging Face caches are used by default. Do not put credentials here.
